{
  "workspaces": [
    "packages/*",
    ".docs",
    ".storybook"
  ],
  "packageManager": "pnpm@10.8.0",
  "version": "1.3.1",
  "private": false,
  "engines": {
    "node": ">=20.18.0"
  },
  "type": "module",
  "readme": "README.md",
  "scripts": {
    "dev": "vite",
    "CICD": "node ./scripts/CICD.mjs",
    "build": "vite build --mode production & node ./scripts/build.mjs",
    "build:component": "tsx scripts/buildComponent.mts",
    "build:component--only": "tsx scripts/buildComponent.mts build",
    "build:publish--only": "tsx scripts/buildComponent.mts publish",
    "preview": "vite preview",
    "pages:build": "vite build --mode github",
    "type-check": "vue-tsc --build",
    "lint-check": "eslint --inspect-config",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "prepare": "node .husky/install.mjs",
    "lint-staged": "lint-staged",
    "commit": "git-cz"
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {},
      "autoprefixer": {}
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix --no-warn-ignored"
    ],
    "*.{css,scss,less,vue}": [
      "stylelint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "license": "MIT",
  "author": "1983531544@qq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/componentProject/vue-component.git"
  },
  "keywords": [
    "element-plus",
    "ElementPlus",
    "vue",
    "vite",
    "vue3",
    "ts",
    "eslint",
    "commitlint",
    "husky",
    "lint-staged",
    "typescript",
    "vite",
    "pinia",
    "router",
    "sass",
    "tailwindcss",
    "template"
  ],
  "dependencies": {
    "@moluoxixi/components": "workspace:*",
    "@moluoxixi/storybook": "workspace:*",
    "@moluoxixi/docs": "workspace:*",
    "@element-plus/icons-vue": "^2.3.1",
    "@sentry/vue": "^9.27.0",
    "@vue-macros/volar": "3.0.0-beta.15",
    "@vue/language-core": "^3.0.1",
    "axios": "^1.9.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "element-plus": "^2.10.1",
    "gitalk": "^1.8.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "pinia": "2.3.0",
    "pinia-plugin-persistedstate": "^4.2.0",
    "radash": "^12.1.0",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.1",
    "vue-router": "4.5.0",
    "vxe-table": "4.13.39"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.1",
    "rollup-obfuscator": "^4.1.1",
    "dependency-cruiser": "^16.10.4",
    "tsx": "^4.19.3",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.14.0",
    "@types/sortablejs": "^1.15.8",
    "@types/uuid": "^10.0.0",
    "@vue/compiler-sfc": "^3.5.17",
    "@vue/tsconfig": "^0.7.0",
    "commitizen": "^4.3.1",
    "compressing": "^1.10.1",
    "cz-customizable": "^7.4.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.22.0",
    "eslint-plugin-format": "^1.0.1",
    "fast-glob": "^3.3.3",
    "feed": "^5.1.0",
    "globby": "^14.1.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "lint-staged": "^15.5.1",
    "npm-run-all2": "^7.0.2",
    "pkg-types": "^2.2.0",
    "sass": "^1.87.0",
    "postcss": "^8.5.3",
    "sass-embedded": "^1.87.0",
    "sass-loader": "^16.0.5",
    "stylelint": "^16.17.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-less": "^3.0.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "typescript": "~5.8.0",
    "vite": "^6.2.4",
    "vue-tsc": "^2.2.8"
  }
}
