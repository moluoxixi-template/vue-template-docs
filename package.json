{
  "workspaces": [
    "packages/*",
    ".docs",
    ".storybook"
  ],
  "packageManager": "pnpm@10.8.0",
  "version": "1.3.1",
  "private": false,
  "engines": {
    "node": ">=20.18.0"
  },
  "type": "module",
  "readme": "README.md",
  "scripts": {
    "dev": "pnpm run -C packages/render dev",
    "CICD": "node ./scripts/CICD.mjs",
    "docs:dev": "pnpm run -C .docs dev",
    "docs:build": "pnpm run -C .docs build",
    "build": "vite build --mode production & node ./scripts/build.mjs",
    "build:component": "pnpm run -C packages/components build",
    "build:component--only": "pnpm run -C packages/components build:only",
    "build:publish--only": "pnpm run -C packages/components build:publish",
    "preview": "vite preview",
    "pages:build": "vite build --mode github",
    "type-check": "vue-tsc --build",
    "lint-check": "eslint --inspect-config",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "prepare": "node .husky/install.mjs",
    "lint-staged": "lint-staged",
    "commit": "git-cz"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix --no-warn-ignored"
    ],
    "*.{css,scss,less,vue}": [
      "stylelint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "license": "MIT",
  "author": "1983531544@qq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/componentProject/vue-component.git"
  },
  "keywords": [
    "element-plus",
    "ElementPlus",
    "vue",
    "vite",
    "vue3",
    "ts",
    "eslint",
    "commitlint",
    "husky",
    "lint-staged",
    "typescript",
    "vite",
    "pinia",
    "router",
    "sass",
    "tailwindcss",
    "template"
  ],
  "dependencies": {
    "@moluoxixi/components": "workspace:*",
    "@moluoxixi/render": "workspace:*",
    "@moluoxixi/docs": "workspace:*",
    "@moluoxixi/storybook": "workspace:*"

  }
}
