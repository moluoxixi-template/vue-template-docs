{
  "workspaces": [
    "packages/*",
    ".docs",
    ".storybook"
  ],
  "packageManager": "pnpm@10.8.0",
  "version": "1.3.1",
  "private": false,
  "engines": {
    "node": ">=20.18.0"
  },
  "type": "module",
  "readme": "README.md",
  "scripts": {
    "vue:dev": "pnpm run -C packages/render dev",
    "vue:build": "pnpm run -C packages/render build",
    "docs:dev": "pnpm run -C .docs dev",
    "docs:build": "pnpm run -C .docs build",
    "component:build&publish": "pnpm run -C packages/components build",
    "component:build": "pnpm run -C packages/components build:only",
    "component:publish": "pnpm run -C packages/components build:publish",
    "component:vue2build&publish": "pnpm run -C packages/vue2components build",
    "component:vue2build": "pnpm run -C packages/vue2components build:only",
    "component:vue2publish": "pnpm run -C packages/vue2components build:publish",
    "type-check": "vue-tsc --build",
    "lint-check": "eslint --inspect-config",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",

    "lint-staged": "lint-staged",
    "commit": "git-cz"
  },
  "lint-staged": {
    "*.{css,scss,less,vue}": [
      "stylelint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "license": "MIT",
  "author": "1983531544@qq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/componentProject/vue-component.git"
  },
  "keywords": [
    "element-plus",
    "ElementPlus",
    "vue",
    "vite",
    "vue3",
    "ts",
    "eslint",
    "commitlint",
    "husky",
    "lint-staged",
    "typescript",
    "vite",
    "pinia",
    "router",
    "sass",
    "tailwindcss",
    "template"
  ],
  "dependencies": {
    "@moluoxixi/components": "workspace:*",
    "@moluoxixi/render": "workspace:*",
    "@moluoxixi/docs": "workspace:*",
    "@moluoxixi/storybook": "workspace:*"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "@antfu/eslint-config": "^4.16.1",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.4.0",
    "lint-staged": "^15.5.1",
    "npm-run-all2": "^7.0.2",
    "typescript": "~5.8.0",
    "eslint": "^9.22.0",
    "eslint-plugin-format": "^1.0.1"
  }
}
